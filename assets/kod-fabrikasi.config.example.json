{
  "_comment": "Kod Fabrikası v2.0 proje konfigürasyonu. init.sh tarafından üretilir. Bu dosyayı .claude/kod-fabrikasi.config.json olarak kullan. v2: Proje yönetim .md dosyaları .claude/{context,decisions,archives,references}/ altına gruplanır; bundle.py auto-discover ile bu klasörleri tarar.",

  "drive_folder_path": "/Users/<kullanici>/Library/CloudStorage/GoogleDrive-<email>/Drive'ım/DEV_PROJELERI/<proje-adi>",
  "notebook_id": "00000000-0000-0000-0000-000000000000",
  "python_bin": "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3",
  "graphify_bin": "/Library/Frameworks/Python.framework/Versions/3.13/bin/graphify",
  "framework": "flutter",

  "sync_to_notebooklm": true,

  "_critical_docs_note": "v2'de boş bırakılırsa bundle.py auto-discover yapar: README.md (root) + .claude/{context,decisions,archives,references}/*.md. Override gerekirse buraya tam path'leri ekle.",
  "critical_docs": [],

  "sync_dirs": [
    ".claude/archives",
    "graphify-out"
  ],

  "phase_files": {
    "roadmap": ".claude/archives/ROADMAP.md",
    "memory": ".claude/context/MEMORY.md",
    "qa": ".claude/references/QA_REPORTS.md",
    "known_bugs": ".claude/references/KNOWN_BUGS.md",
    "notebooklm_summary": ".claude/archives/NOTEBOOKLM_SUMMARY.md",
    "graphify_notes": ".claude/context/GRAPHIFY_NOTES.md",
    "faz_prompt": ".claude/decisions/FAZ_PROMPT.md",
    "phase_template": ".claude/archives/PHASE_TEMPLATE.md",
    "phase_reports_glob": ".claude/archives/PHASE_*.md"
  },

  "allowed_extensions": [
    ".go", ".proto", ".sql",
    ".js", ".ts", ".tsx", ".jsx",
    ".py", ".json", ".md",
    ".yml", ".yaml", ".html", ".css",
    ".php", ".dart", ".swift", ".kt",
    ".java", ".rb", ".rs"
  ],

  "ignore_dirs": [
    "node_modules", ".git", ".idea", ".vscode",
    "vendor", ".venv", "venv", "dist", "build",
    "graphify-out", "__pycache__", "storage",
    "public", "cache", "views", "snapshots",
    ".dart_tool", ".gradle", ".next", "target"
  ],

  "notebooklm_allowed_extensions": [".md", ".txt", ".pdf"],
  "notebooklm_ignore_dirs": ["cache", "__pycache__"],
  "notebooklm_max_file_size_mb": 50,

  "stale_drive_patterns": []
}
