{
  "_comment": "Kod Fabrikasi v3 proje konfigurasyonu. `kf.py init` uretir; .claude/kod-fabrikasi.config.json olarak durur. Bos/yok olan entegrasyon atlanir (Drive, NotebookLM, Obsidian hepsi istege bagli). Cekirdek: git + alt ajanlar + faz hafizasi + graphify.",
  "version": 3,
  "project_name": "<proje-adi>",
  "language": "tr",
  "_profile_note": "yazilim (varsayilan) | ajans. ajans: cekirdek ekip + agency blogu (asagida). skill_dir: init'in kaydettigi skill kopyasi; proje kopyasindaki kf.py (client add, repair) sablonlari buradan bulur.",
  "profile": "yazilim",
  "skill_dir": "C:\\Users\\<kullanici>\\.claude\\skills\\kod-fabrikasi",

  "python_bin": "C:\\Users\\<kullanici>\\AppData\\Local\\Programs\\Python\\Python313\\python.exe",
  "graphify_bin": "graphify",

  "framework": "node",
  "test_commands": ["npm test", "npm run lint"],
  "build_commands": ["npm run build"],

  "_live_write_commands_note": "Canliya / dis sisteme yazan ya da geri alinamaz komutlar. settings.json `ask` listesine girer; tester ve gelistirici ajanlari bunlari ASLA calistirmaz.",
  "live_write_commands": ["npm run deploy", "prisma migrate reset"],

  "_high_risk_areas_note": "Bu alanlara dokunan her degisiklik reviewer + (varsa) guvenlik-inceleyici'den gecer; buyuk olanlar mimar'a gider.",
  "high_risk_areas": ["auth", "payments", "migrations"],

  "agents": {
    "core": ["kesifci", "gelistirici", "tester", "reviewer", "faz-arsivcisi"],
    "optional": ["mimar", "guvenlik-inceleyici"],
    "domain_experts": [
      { "name": "odeme-uzmani", "domain": "Odeme saglayici API", "paths": ["src/payments/"], "docs_url": "" }
    ],
    "max_parallel_editors": 3
  },

  "_agency_note": "Yalnizca profile = ajans. clients[]: slug = clients/<slug>/ klasoru; betikler --client <slug> ile domain/zone/gsc/ga4/pagespeed degerlerini alir. optional_agents: reklam-stratejisti.",
  "agency": {
    "clients_dir": "clients",
    "shared_dir": "shared",
    "credentials_dir": ".credentials",
    "agents": ["metin-yazari", "marka-denetcisi", "seo-teknisyeni", "rakip-analisti", "site-denetcisi", "cloudflare-operatoru"],
    "optional_agents": ["reklam-stratejisti"],
    "clients": [
      {
        "slug": "musteri-a",
        "name": "Musteri A",
        "domain": "musteri-a.com",
        "cloudflare_zone": "musteri-a.com",
        "gsc_site": "sc-domain:musteri-a.com",
        "ga4_property": "123456789",
        "pagespeed_urls": ["https://musteri-a.com/", "https://musteri-a.com/hizmetler/"]
      }
    ]
  },

  "phase_files": {
    "roadmap": ".claude/archives/ROADMAP.md",
    "progress": ".claude/archives/PROGRESS.md",
    "decisions": ".claude/decisions/DECISIONS.md",
    "open_questions": ".claude/decisions/OPEN_QUESTIONS.md",
    "memory": ".claude/context/MEMORY.md",
    "qa": ".claude/references/QA_REPORTS.md",
    "known_bugs": ".claude/references/KNOWN_BUGS.md",
    "notebooklm_summary": ".claude/archives/NOTEBOOKLM_SUMMARY.md",
    "graphify_notes": ".claude/context/GRAPHIFY_NOTES.md",
    "phase_template": ".claude/archives/PHASE_TEMPLATE.md",
    "phase_reports_glob": ".claude/archives/PHASE_*.md"
  },

  "integrations": {
    "graphify": { "enabled": true, "viz_node_limit": 15000 },
    "drive": {
      "enabled": false,
      "folder_path": "G:\\Drive'im\\DEV_PROJELERI\\<proje-adi>"
    },
    "notebooklm": {
      "enabled": false,
      "notebook_id": "",
      "allowed_extensions": [".md", ".txt", ".pdf"],
      "ignore_dirs": ["cache", "__pycache__"],
      "max_file_size_mb": 50
    },
    "obsidian": {
      "enabled": false,
      "vault_path": "D:\\obsidian_kasalar\\<proje-adi>"
    }
  },

  "bundle": {
    "_note": "Paket SADECE git'in izledigi dosyalardan (git ls-files) olusur; .env, dump, veritabani dosyalari git disinda oldugu icin hic girmez. Drive kapaliysa cikti .claude/bundle-out/ (gitignore) altina yazilir.",
    "allowed_extensions": [
      ".go", ".proto", ".sql", ".js", ".mjs", ".ts", ".tsx", ".jsx", ".vue", ".svelte", ".astro",
      ".py", ".json", ".md", ".yml", ".yaml", ".toml", ".html", ".css", ".scss",
      ".php", ".dart", ".swift", ".kt", ".java", ".rb", ".rs", ".cs", ".sh"
    ],
    "skip_files": ["package-lock.json", "pnpm-lock.yaml", "yarn.lock", "composer.lock", "pubspec.lock", "Cargo.lock", "poetry.lock"],
    "skip_prefixes": [".claude/skills/", "graphify-out/"],
    "sync_dirs": [".claude/archives", "graphify-out"],
    "stale_patterns": []
  },

  "hooks": {
    "pre_commit_secret_scan": true,
    "post_commit_end_phase": true,
    "secret_name_patterns": ["\\.env$", "\\.env\\.", "\\.pem$", "\\.key$", "\\.p12$", "secret", "password", "sifre", "\\.db$", "\\.sqlite", "dump\\.sql"]
  }
}
