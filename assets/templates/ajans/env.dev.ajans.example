# --- Dijital ajans profili: API anahtarlari (betikler okur; Claude okuyamaz) ---
# Cloudflare API Token (Global API Key DEGIL). Izinler: references/cloudflare.md
CLOUDFLARE_API_TOKEN=
# Pages komutlari icin hesap id (bos = /accounts'tan ilk hesap)
CLOUDFLARE_ACCOUNT_ID=
# Google Cloud > PageSpeed Insights API (anahtarsiz kota cok dusuk)
PAGESPEED_API_KEY=
# Google Cloud > YouTube Data API v3 (yorum, arama, istatistik)
YOUTUBE_API_KEY=
# Google service account JSON yolu (GSC + GA4). Bos = .credentials/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
