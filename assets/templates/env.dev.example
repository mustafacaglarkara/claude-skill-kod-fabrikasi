# .env.dev — {{PROJECT_NAME}} icin makineye ozel entegrasyon degerleri ve anahtarlar (Kod Fabrikasi)
# Kopyala: .env.dev.example -> .env.dev ve doldur. .env.dev git DISIDIR (.gitignore) ve Claude okuyamaz
# (settings deny); kf.py ve .claude/scripts/ajans/*.py betikleri okur, degerleri hicbir ciktiya yazmaz.
# Bos deger = entegrasyon kapali. Dolu deger config'teki ayari ezer ve entegrasyonu acar.
# Baska bir dosya kullanmak icin: KF_ENV_FILE=.env.local

# Google Drive masaustu klasoru (kf.py bundle ciktisi). Bos = .claude/bundle-out/ (yerel)
KF_DRIVE_FOLDER=

# NotebookLM notebook id (notebooklm-py ile birebir aynalama). Bos = kapali
KF_NOTEBOOKLM_ID=

# Obsidian kasa yolu (kf.py sync; kasada "Proje" junction'i). Bos = kapali
KF_OBSIDIAN_VAULT=

# notebooklm-py'nin kurulu oldugu Python'un tam yolu. Bos = config python_bin
KF_PYTHON_BIN=

# graphify ikilisinin tam yolu. Bos = PATH'teki graphify
KF_GRAPHIFY_BIN=
